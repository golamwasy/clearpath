VITE_MENU_API_URL=http://localhost:8081
VITE_AVAILABILITY_API_URL=http://localhost:8082
VITE_POS_API_URL=http://localhost:8083
VITE_TRACE_API_URL=http://localhost:8084

# menu-service has no seed data. Create a venue (POST /venues) and put its
# id here, or the menu/availability nav links and the chaos panel's
# duplicate-delivery diff have nothing to point at — see README's Setup
# section. Left unset here on purpose: a venue id is server-generated per
# environment, not a fixed default.
VITE_DEFAULT_VENUE_ID=
